---
// Contact.astro
---

<section id="contacto" class="section-padding bg-cream">
  <div class="container-narrow">
    <div class="grid md:grid-cols-12 gap-16">

      <!-- Left: Info -->
      <div class="md:col-span-5">
        <p class="text-xs tracking-[0.3em] uppercase text-gold mb-4 flex items-center gap-3">
          <span class="w-8 h-px bg-gold"></span>
          Contacto
        </p>
        <h2
          class="font-display text-ink leading-tight mb-8"
          style="font-size: var(--text-display-md);"
        >
          Hablemos de<br />
          su <em class="text-gold not-italic">caso.</em>
        </h2>

        <p class="text-ink-muted leading-relaxed mb-12">
          La primera consulta es gratuita y completamente confidencial. 
          Cuéntenos su situación y le diremos cómo podemos ayudarle.
        </p>

        <!-- Contact details -->
        <div class="flex flex-col gap-6">
          {[
            {
              icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z"/>`,
              label: "Teléfono",
              value: "+51 1 234 5678",
            },
            {
              icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"/>`,
              label: "Correo",
              value: "contacto@martinezasociados.pe",
            },
            {
              icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"/>`,
              label: "Dirección",
              value: "Av. Javier Prado Este 3580, San Borja, Lima",
            },
          ].map((item) => (
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 border border-gold flex items-center justify-center shrink-0">
                <svg class="w-4 h-4 text-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" set:html={item.icon}></svg>
              </div>
              <div>
                <p class="text-xs tracking-widest uppercase text-ink-muted mb-0.5">{item.label}</p>
                <p class="text-sm text-ink">{item.value}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right: Form -->
      <div class="md:col-span-7">
        <form class="flex flex-col gap-6" onsubmit="return false;">

          <div class="grid sm:grid-cols-2 gap-6">
            <div class="flex flex-col gap-2">
              <label class="text-xs tracking-widest uppercase text-ink-muted" for="nombre">
                Nombre
              </label>
              <input
                id="nombre"
                type="text"
                placeholder="Jorge García"
                class="border-b border-cream-dark bg-transparent py-3 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:border-gold transition-colors duration-300"
              />
            </div>
            <div class="flex flex-col gap-2">
              <label class="text-xs tracking-widest uppercase text-ink-muted" for="email">
                Correo electrónico
              </label>
              <input
                id="email"
                type="email"
                placeholder="correo@ejemplo.com"
                class="border-b border-cream-dark bg-transparent py-3 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:border-gold transition-colors duration-300"
              />
            </div>
          </div>

          <div class="flex flex-col gap-2">
            <label class="text-xs tracking-widest uppercase text-ink-muted" for="area">
              Área de consulta
            </label>
            <select
              id="area"
              class="border-b border-cream-dark bg-transparent py-3 text-sm text-ink focus:outline-none focus:border-gold transition-colors duration-300 cursor-pointer appearance-none"
            >
              <option value="" disabled selected>Seleccione un área</option>
              <option>Derecho Civil</option>
              <option>Derecho Corporativo</option>
              <option>Derecho Penal</option>
              <option>Derecho Laboral</option>
              <option>Derecho Familiar</option>
              <option>Derecho Administrativo</option>
            </select>
          </div>

          <div class="flex flex-col gap-2">
            <label class="text-xs tracking-widest uppercase text-ink-muted" for="mensaje">
              Cuéntenos su caso
            </label>
            <textarea
              id="mensaje"
              rows="5"
              placeholder="Describa brevemente su situación..."
              class="border-b border-cream-dark bg-transparent py-3 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:border-gold transition-colors duration-300 resize-none"
            ></textarea>
          </div>

          <div class="flex items-start gap-3">
            <input id="privacidad" type="checkbox" class="mt-1 w-4 h-4 accent-gold cursor-pointer" />
            <label for="privacidad" class="text-xs text-ink-muted leading-relaxed cursor-pointer">
              Acepto la política de privacidad y entiendo que la información proporcionada 
              es confidencial y no será compartida con terceros.
            </label>
          </div>

          <button
            type="submit"
            class="self-start inline-flex items-center gap-3 bg-ink text-cream px-10 py-4 text-sm tracking-widest uppercase hover:bg-gold transition-all duration-300 group"
          >
            Enviar consulta
            <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3"/>
            </svg>
          </button>

        </form>
      </div>

    </div>
  </div>
</section>