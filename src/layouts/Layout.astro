---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="Martínez & Asociados — Estudio jurídico especializado en derecho civil, corporativo, penal y laboral. Lima, Perú."
		/>
		<meta name="author" content="Martínez & Asociados" />
		<title>Martínez & Asociados — Estudio Jurídico</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&display=swap"
			rel="stylesheet"
		/>
		<meta
			property="og:title"
			content="Martínez & Asociados — Estudio Jurídico"
		/>
		<meta
			property="og:description"
			content="Asesoría legal de alto nivel en Lima, Perú."
		/>
		<meta property="og:type" content="website" />
		<ClientRouter />
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
