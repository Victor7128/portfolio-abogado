<header
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-500"
>
  <div class="container-narrow">
    <nav class="flex items-center justify-between py-6">
      <a
        href="/"
        class="font-display text-xl tracking-widest uppercase text-ink hover:text-gold transition-colors duration-300"
      >
        Martínez <span class="text-gold">&</span> Asociados
      </a>

      <ul class="hidden md:flex items-center gap-10">
        {[
          { href: "#inicio",    label: "Inicio"    },
          { href: "#servicios", label: "Servicios" },
          { href: "#nosotros",  label: "Nosotros"  },
          { href: "#casos",     label: "Casos"     },
          { href: "#contacto",  label: "Contacto"  },
        ].map((item) => (
          <li>
            <a
              href={item.href}
              class="text-sm tracking-widest uppercase text-ink-muted hover:text-ink transition-colors duration-300 relative group"
            >
              {item.label}
              <span class="absolute -bottom-0.5 left-0 w-0 h-px bg-gold transition-all duration-300 group-hover:w-full"></span>
            </a>
          </li>
        ))}
      </ul>

      <a
        href="#contacto"
        class="hidden md:inline-flex items-center gap-2 text-sm tracking-widest uppercase border border-gold text-gold px-6 py-2.5 hover:bg-gold hover:text-cream transition-all duration-300"
      >
        Consulta Gratis
      </a>

      <!-- Mobile Burger -->
      <button
        id="menu-toggle"
        class="md:hidden flex flex-col gap-1.5 p-1"
        aria-label="Abrir menú"
      >
        <span class="w-6 h-px bg-ink transition-all duration-300 block" id="bar1"></span>
        <span class="w-6 h-px bg-ink transition-all duration-300 block" id="bar2"></span>
        <span class="w-4 h-px bg-ink transition-all duration-300 block" id="bar3"></span>
      </button>
    </nav>
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="md:hidden hidden bg-cream border-t border-cream-dark px-6 py-8"
  >
    <ul class="flex flex-col gap-6">
      {[
        { href: "#inicio",    label: "Inicio"    },
        { href: "#servicios", label: "Servicios" },
        { href: "#nosotros",  label: "Nosotros"  },
        { href: "#casos",     label: "Casos"     },
        { href: "#contacto",  label: "Contacto"  },
      ].map((item) => (
        <li>
          <a
            href={item.href}
            class="font-display text-2xl text-ink hover:text-gold transition-colors duration-300"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
    <a
      href="#contacto"
      class="mt-8 inline-flex text-sm tracking-widest uppercase border border-gold text-gold px-6 py-3 hover:bg-gold hover:text-cream transition-all duration-300"
    >
      Consulta Gratis
    </a>
  </div>
</header>

<script>
  const navbar   = document.getElementById("navbar")!;
  const toggle   = document.getElementById("menu-toggle")!;
  const mobileMenu = document.getElementById("mobile-menu")!;

  // Scroll: glass effect
  window.addEventListener("scroll", () => {
    if (window.scrollY > 40) {
      navbar.classList.add("bg-[var(--color-cream)]/95", "backdrop-blur-sm", "shadow-sm");
    } else {
      navbar.classList.remove("bg-[var(--color-cream)]/95", "backdrop-blur-sm", "shadow-sm");
    }
  });

  // Mobile toggle
  toggle.addEventListener("click", () => {
    mobileMenu.classList.toggle("hidden");
  });

  // Close on link click
  mobileMenu.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => mobileMenu.classList.add("hidden"));
  });
</script>