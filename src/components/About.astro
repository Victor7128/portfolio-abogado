---
// About.astro

const credentials = [
  { year: "2008", text: "Licenciatura en Derecho — PUCP"              },
  { year: "2011", text: "Maestría en Derecho Corporativo — UNED Madrid" },
  { year: "2013", text: "Socio fundador de Martínez & Asociados"       },
  { year: "2019", text: "Premio Nacional al Litigante del Año"         },
];
---

<section id="nosotros" class="section-padding bg-cream">
  <div class="container-narrow">
    <div class="grid md:grid-cols-12 gap-16 items-start">

      <!-- Left: Image column -->
      <div class="md:col-span-5 relative">
        <!-- Photo placeholder -->
        <div class="aspect-3/4 bg-cream-dark relative overflow-hidden">
          <img
            src="/images/abogado-portrait.webp"
            alt="Dr. Jorge Martínez"
            class="absolute inset-0 w-full h-full object-cover object-top"
          />
          <div class="absolute inset-0 flex items-center justify-center">
            <p class="font-display text-cream text-8xl opacity-20">JM</p>
          </div>
          <!-- Corner ornaments -->
          <div class="absolute top-4 left-4 border-t border-l border-gold w-10 h-10 opacity-60"></div>
          <div class="absolute bottom-4 right-4 border-b border-r border-gold w-10 h-10 opacity-60"></div>
        </div> 

        <!-- Badge -->
        <div class="absolute -bottom-6 -right-4 md:-right-6 bg-gold text-cream p-6 shadow-lg">
          <p class="font-display text-5xl leading-none">15</p>
          <p class="text-xs tracking-widest uppercase mt-1 opacity-80">años de<br/>trayectoria</p>
        </div>
      </div>

      <!-- Right: Content -->
      <div class="md:col-span-7 md:pt-8">
        <p class="text-xs tracking-[0.3em] uppercase text-gold mb-4 flex items-center gap-3">
          <span class="w-8 h-px bg-gold"></span>
          Sobre Nosotros
        </p>

        <h2
          class="font-display text-ink leading-tight mb-8"
          style="font-size: var(--text-display-md);"
        >
          Experiencia, integridad<br />
          y resultados <em class="text-gold not-italic">concretos.</em>
        </h2>

        <div class="flex flex-col gap-5 text-ink-muted leading-relaxed mb-12">
          <p>
            El Dr. Jorge Martínez fundó este estudio con una visión clara: brindar asesoría 
            jurídica de alto nivel con el trato cercano que cada cliente merece. Cada caso 
            es abordado con la seriedad y la dedicación de un litigio de primer orden.
          </p>
          <p>
            Nuestro equipo de nueve abogados especializados trabaja de forma coordinada 
            para ofrecer soluciones integrales, anticipando riesgos y actuando con 
            estrategia en cada etapa del proceso.
          </p>
        </div>

        <!-- Credentials timeline -->
        <div class="flex flex-col gap-0 border-l border-cream-dark pl-6">
          {credentials.map((item, i) => (
            <div class={`relative pb-8 last:pb-0 ${i === credentials.length - 1 ? '' : 'border-b border-cream-dark'}`}>
              <!-- Dot -->
              <div class="absolute left-[-1.65rem] top-0.5 w-3 h-3 rounded-full border-2 border-gold bg-cream"></div>
              <p class="text-xs tracking-widest uppercase text-gold mb-1 pt-0">{item.year}</p>
              <p class="text-sm text-ink-light">{item.text}</p>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>